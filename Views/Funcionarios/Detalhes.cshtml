@model dynamic
@{
    var funcionario = Model.funcionario;
    var equipamentos = Formatador.Lista(Model.equipamentos);
    var historico = Formatador.Lista(Model.historico);
}

<section class="content-card p-3 mb-3">
    <div class="page-header">
        <div>
            <h1>@funcionario.Nome</h1>
            <p class="text-muted mb-0">@Formatador.Texto(funcionario.Cargo) · @funcionario.Setor</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
    </div>
    <dl class="row detalhe-campo mb-0">
        <div class="col-md-6"><dt>E-mail</dt><dd>@Formatador.Texto(funcionario.Email)</dd></div>
        <div class="col-md-6"><dt>Telefone</dt><dd>@Formatador.Texto(funcionario.Telefone)</dd></div>
        <div class="col-md-6"><dt>Matrícula</dt><dd>@Formatador.Texto(funcionario.Matricula)</dd></div>
        <div class="col-md-6"><dt>Tipo de trabalho</dt><dd>@funcionario.TipoTrabalho</dd></div>
        <div class="col-md-6"><dt>Endereço</dt><dd>@Formatador.Texto(funcionario.Endereco)</dd></div>
        <div class="col-md-6"><dt>Número</dt><dd>@Formatador.Texto(funcionario.Numero)</dd></div>
        <div class="col-md-6"><dt>CEP</dt><dd>@Formatador.Texto(funcionario.Cep)</dd></div>
        <div class="col-md-6"><dt>Bairro</dt><dd>@Formatador.Texto(funcionario.Bairro)</dd></div>
        <div class="col-md-6"><dt>Cidade</dt><dd>@Formatador.Texto(funcionario.Cidade)</dd></div>
        <div class="col-md-6"><dt>UF</dt><dd>@Formatador.Texto(funcionario.Uf)</dd></div>
        <div class="col-md-6"><dt>Complemento</dt><dd>@Formatador.Texto(funcionario.Complemento)</dd></div>
        <div class="col-md-6"><dt>Nascimento</dt><dd>@(funcionario.DataNascimento == null ? "—" : ((DateTime)funcionario.DataNascimento).ToString("dd/MM/yyyy"))</dd></div>
        <div class="col-md-6"><dt>Admissão</dt><dd>@(funcionario.DataAdmissao == null ? "—" : ((DateTime)funcionario.DataAdmissao).ToString("dd/MM/yyyy"))</dd></div>
        <div class="col-md-6">
            <dt>Tempo de empresa</dt>
            <dd class="text-wrap">
                @if (funcionario.DataAdmissao == null)
                {
                    <span class="text-muted">Admissão não informada</span>
                }
                else
                {
                    var admissao = ((DateTime)funcionario.DataAdmissao).Date;
                    <span class="status-badge @(admissao > DateTime.Today ? "status-pendente" : "status-ativo")">@Formatador.TempoDeEmpresa(admissao)</span>
                }
            </dd>
        </div>
    </dl>
</section>
<section class="content-card p-3 mb-3">
    <h2 class="fw-bold mb-3">Equipamentos atuais</h2>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Patrimônio</th><th>Modelo</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var item in equipamentos)
                {
                    <tr>
                        <td><a asp-controller="Equipamentos" asp-action="Detalhes" asp-route-id="@item.Id">@Formatador.Texto(item.NumeroPatrimonio)</a></td>
                        <td>@item.Modelo</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<section class="content-card p-3">
    <h2 class="fw-bold mb-3">Histórico</h2>
    <partial name="Componentes/_TabelaMovimentacoes" model="historico" />
</section>

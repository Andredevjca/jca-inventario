@model dynamic
@{
    var funcionario = Model.funcionario;
    var equipamentos = Formatador.Lista(Model.equipamentos);
    var historico = Formatador.Lista(Model.historico);
}
<div class="page-header">
    <div>
        <h1>@funcionario.Nome</h1>
        <p class="text-muted mb-0">@Formatador.Texto(funcionario.Cargo) · @funcionario.Setor</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
</div>
<section class="content-card p-3 mb-3">
    <dl class="row detalhe-campo mb-0">
        <div class="col-md-6"><dt>E-mail</dt><dd>@Formatador.Texto(funcionario.Email)</dd></div>
        <div class="col-md-6"><dt>Telefone</dt><dd>@Formatador.Texto(funcionario.Telefone)</dd></div>
        <div class="col-md-6"><dt>Matrícula</dt><dd>@Formatador.Texto(funcionario.Matricula)</dd></div>
        <div class="col-md-6"><dt>Tipo de trabalho</dt><dd>@funcionario.TipoTrabalho</dd></div>
    </dl>
</section>
<section class="content-card p-3 mb-3">
    <h2 class="fw-bold mb-3">Equipamentos atuais</h2>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Patrimônio</th><th>Modelo</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var item in equipamentos)
            {
                <tr>
                    <td><a asp-controller="Equipamentos" asp-action="Detalhes" asp-route-id="@item.Id">@Formatador.Texto(item.NumeroPatrimonio)</a></td>
                    <td>@item.Modelo</td>
                    <td>@item.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
<section class="content-card p-3">
    <h2 class="fw-bold mb-3">Histórico</h2>
    <partial name="Componentes/_TabelaMovimentacoes" model="historico" />
</section>

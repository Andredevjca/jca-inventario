@model IEnumerable<dynamic>

<div class="content-card p-3">
    <div class="page-header">
        <div>
            <h1>Funcionários</h1>
            <p class="text-muted mb-0">Cadastro, consulta e atualização dos registros.</p>
        </div>
        <a class="btn btn-success btn-modern" asp-action="Criar"><i class="fa-solid fa-plus"></i> Novo registro</a>
    </div>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Matrícula</th>
                    <th>Cargo</th>
                    <th>Setor</th>
                    <th>E-mail</th>
                    <th>Status</th>
                    <th class="alinhar_a_direita">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var ativo = Convert.ToBoolean(item.Ativo);
                    <tr>
                        <td>@item.Nome</td>
                        <td>@Formatador.Texto(item.Matricula)</td>
                        <td>@Formatador.Texto(item.Cargo)</td>
                        <td>@item.Setor</td>
                        <td>@Formatador.Texto(item.Email)</td>
                        <td><span class="status-badge @Formatador.ClasseStatus(ativo ? "Ativo" : "Inativo")">@(ativo ? "Ativo" : "Inativo")</span></td>
                        <td class="text-nowrap alinhar_a_direita">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Id"><i class="fa-solid fa-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

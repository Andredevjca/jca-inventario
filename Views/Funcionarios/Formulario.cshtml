@model Funcionario

<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div class="page-header">
        <div>
            <h1>@(Model.Id == 0 ? "Novo funcionário" : "Editar funcionário")</h1>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Telefone" class="form-label"></label>
            <input asp-for="Telefone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Matricula" class="form-label"></label>
            <input asp-for="Matricula" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="FuncaoId" class="form-label"></label>
            <select asp-for="FuncaoId" class="form-select">
                <option value="">Selecione</option>
                @foreach (var funcao in Formatador.Lista(ViewBag.Funcoes))
                {
                    if (Convert.ToBoolean(funcao.Ativo) || Model.FuncaoId == Convert.ToInt32(funcao.Id))
                    {
                        <option value="@funcao.Id">@funcao.Nome@(Convert.ToBoolean(funcao.Ativo) ? "" : " (inativa)")</option>
                    }
                }
            </select>
            <a asp-controller="Funcoes" asp-action="Index" class="form-text">Cadastrar funções</a>
        </div>
        <div class="col-md-6">
            <label asp-for="SetorId" class="form-label"></label>
            <select asp-for="SetorId" class="form-select">
                <option value="">Selecione</option>
                @foreach (var setor in Formatador.Lista(ViewBag.Setores))
                {
                    <option value="@setor.Id">@setor.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="TipoTrabalho" class="form-label"></label>
            <select asp-for="TipoTrabalho" class="form-select">
                @foreach (var tipo in JcaInventario.Configuracoes.OpcoesInventario.TiposTrabalho)
                {
                    <option>@tipo</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="DataNascimento" class="form-label"></label>
            <input asp-for="DataNascimento" class="form-control" type="date" />
        </div>
        <div class="col-md-6">
            <label asp-for="DataAdmissao" class="form-label"></label>
            <input asp-for="DataAdmissao" class="form-control" type="date" />
        </div>
        <div class="col-md-6">
            <label asp-for="Cep" class="form-label"></label>
            <input asp-for="Cep" class="form-control" inputmode="numeric" autocomplete="postal-code" aria-describedby="cep-status" />
            <div id="cep-status" class="form-text" role="status" aria-live="polite">Digite oito dígitos para consultar o endereço.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Endereco" class="form-label"></label>
            <input asp-for="Endereco" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Numero" class="form-label"></label>
            <input asp-for="Numero" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Complemento" class="form-label"></label>
            <input asp-for="Complemento" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Bairro" class="form-label"></label>
            <input asp-for="Bairro" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Cidade" class="form-label"></label>
            <input asp-for="Cidade" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Uf" class="form-label"></label>
            <select asp-for="Uf" class="form-select">
                <option value="">Selecione</option>
                @foreach (var uf in "AC AL AP AM BA CE DF ES GO MA MT MS MG PA PB PR PE PI RJ RN RS RO RR SC SP SE TO".Split(' '))
                {
                    <option>@uf</option>
                }
            </select>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <label asp-for="Observacoes" class="form-label"></label>
            <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@model JcaInventario.ViewModels.MovimentacaoViewModel
<div class="page-header">
    <div>
        <h1>Movimentar equipamento</h1>
        <p class="text-muted mb-0">@ViewBag.Equipamento.Marca @ViewBag.Equipamento.Modelo</p>
    </div>
</div>
<form method="post" class="content-card p-4" data-vinculo-equipamento>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select">
                @foreach (var tipo in (IEnumerable<string>)ViewBag.Movimentacoes)
                {
                    <option>@tipo</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="ResponsavelId" class="form-label">Novo responsável</label>
            <select asp-for="ResponsavelId" class="form-select">
                <option value="">Sem responsável</option>
                @foreach (var funcionario in Formatador.Lista(ViewBag.Funcionarios))
                {
                    <option value="@funcionario.Id">@funcionario.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (var status in (IEnumerable<string>)ViewBag.Status)
                {
                    <option>@status</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Localizacao" class="form-label"></label>
            <select asp-for="Localizacao" class="form-select">
                @foreach (var local in (IEnumerable<string>)ViewBag.Localizacoes)
                {
                    <option>@local</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Observacao" class="form-label">Observação</label>
            <textarea asp-for="Observacao" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Detalhes" asp-route-id="@ViewBag.Equipamento.Id">Cancelar</a>
    </div>
</form>

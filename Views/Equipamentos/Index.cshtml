@model IEnumerable<dynamic>
<div class="page-header">
    <div>
        <h1>Equipamentos</h1>
        <p class="text-muted mb-0">Responsáveis, localização e situação dos equipamentos.</p>
    </div>
    <a class="btn btn-success btn-modern" asp-action="Criar"><i class="fa-solid fa-plus"></i> Novo equipamento</a>
</div>
<form class="content-card p-3 mb-3" method="get">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Buscar</label>
            <input name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Patrimônio, modelo, responsável..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">Todos</option>
                @foreach (var status in (IEnumerable<string>)ViewBag.StatusOpcoes)
                {
                    <option value="@status" selected="@(ViewBag.Status as string == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Localização</label>
            <select name="localizacao" class="form-select">
                <option value="">Todas</option>
                @foreach (var local in (IEnumerable<string>)ViewBag.Localizacoes)
                {
                    <option value="@local" selected="@(ViewBag.Localizacao as string == local)">@local</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
    </div>
</form>
<div class="content-card p-3">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Patrimônio</th>
                    <th>Tipo</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Responsável</th>
                    <th>Setor</th>
                    <th>Localização</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Detalhes" asp-route-id="@item.Id">@Formatador.Texto(item.NumeroPatrimonio)</a></td>
                        <td>@item.Tipo</td>
                        <td>@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td>@Formatador.Texto(item.Responsavel)</td>
                        <td>@Formatador.Texto(item.Setor)</td>
                        <td>@item.Localizacao</td>
                        <td><span class="status-badge @Formatador.ClasseStatus(Convert.ToString(item.Status))">@item.Status</span></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalhes" asp-route-id="@item.Id" title="Visualizar"><i class="fa-solid fa-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@item.Id" title="Editar"><i class="fa-solid fa-pen"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

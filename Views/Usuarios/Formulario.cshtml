@model Usuario

<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div class="page-header">
        <div>
            <h1>@(Model.Id == 0 ? "Novo usuário" : "Editar usuário")</h1>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" />
            @if (Model.Id > 0)
            {
                <div class="form-text">Deixe em branco para manter a senha atual.</div>
            }
        </div>
        <div class="col-md-12 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="Administrador" class="form-check-input" />
                <label asp-for="Administrador" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-12 d-flex align-items-end" style="margin-top: 0px;">
            <div class="form-check">
                <input asp-for="Ativo" class="form-check-input" />
                <label asp-for="Ativo" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-success btn-modern">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@model dynamic
@{
    var inventario = Model.inventario;
    var itens = Formatador.Lista((object?)Model.itens).ToList();
    var encerrado = Convert.ToBoolean(inventario.Encerrado);
}

@if (itens.Any(item => !Convert.ToBoolean((object)item.CapturadoNaCriacao)))
{
    <div class="alert alert-warning">Inventário legado: os dados dos equipamentos foram preservados na atualização do sistema. Eles podem diferir dos dados da criação original. A data da captura consta no PDF.</div>
}
<div class="content-card p-3">
    <div class="page-header">
        <div>
            <h1>@inventario.Nome</h1>
            <p class="text-muted mb-0">Total: @itens.Count</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
            <a class="btn btn-outline-secondary" asp-action="Pdf" asp-route-id="@inventario.Id" data-no-spa><i class="fa-solid fa-file-pdf"></i> Exportar PDF por setor</a>
            @if (!encerrado)
            {
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalExclusao" data-url="@Url.Action("Encerrar", new { id = inventario.Id })" data-mensagem="Encerrar este inventário? As conferências ficarão apenas para consulta.">Encerrar inventário</button>
            }
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Patrimônio</th>
                    <th>Equipamento</th>
                    <th>Responsável</th>
                    <th>Setor</th>
                    <th>Localização</th>
                    <th>Situação</th>
                    <th>Observação</th>
                    <th class="alinhar_a_direita">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in itens)
                {
                    <tr>
                        <td>@Formatador.Texto(item.NumeroPatrimonio)</td>
                        <td>@item.Modelo</td>
                        <td>@Formatador.Texto(item.Responsavel)</td>
                        <td>@Formatador.Texto(item.Setor)</td>
                        <td>@item.Localizacao</td>
                        <td><span class="status-badge @Formatador.ClasseStatus(Convert.ToString(item.Situacao))">@item.Situacao</span></td>
                        <td>@Formatador.Texto(item.Observacao)</td>
                        <td class="alinhar_a_direita">
                            @if (!encerrado)
                            {
                                <form asp-action="Conferir" asp-route-id="@inventario.Id" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="equipamentoId" value="@item.EquipamentoId" />
                                    <select name="Situacao" class="form-select select-situacao">
                                        <option selected="@(Convert.ToString(item.Situacao) == "Conferido")">Conferido</option>
                                        <option selected="@(Convert.ToString(item.Situacao) == "Pendente")">Pendente</option>
                                        <option selected="@(Convert.ToString(item.Situacao) == "Divergência")">Divergência</option>
                                    </select>
                                    <input name="Observacao" class="form-control" placeholder="Obs." value="@item.Observacao" />
                                    <button class="btn btn-sm btn-primary btn-salvar"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

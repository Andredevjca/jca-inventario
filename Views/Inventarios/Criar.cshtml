@model JcaInventario.ViewModels.NovoInventarioViewModel
<div class="page-header"><div><h1>Novo inventário</h1></div></div>
<form method="post" class="content-card p-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
        <div class="form-text">Inclui os equipamentos atuais, exceto inativos e baixados.</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success btn-modern">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@model IEnumerable<dynamic>
<div class="table-responsive">
    <table class="table table-modern">
        <thead>
            <tr>
                <th>Data</th>
                <th>Patrimônio</th>
                <th>Tipo</th>
                <th>Responsável anterior</th>
                <th>Novo responsável</th>
                <th>Usuário</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="vazio">Nenhum registro encontrado.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@Formatador.DataHora(item.Data as DateTime?)</td>
                        <td>
                            <a asp-controller="Equipamentos" asp-action="Detalhes" asp-route-id="@item.EquipamentoId">@Formatador.Texto(item.NumeroPatrimonio ?? item.Modelo)</a>
                        </td>
                        <td>@item.Tipo</td>
                        <td>@Formatador.Texto(item.ResponsavelAnterior)</td>
                        <td>@Formatador.Texto(item.NovoResponsavel)</td>
                        <td>@Formatador.Texto(item.Usuario)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
